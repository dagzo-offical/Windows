# Disposable VM for Tor Guard integration + leak testing on kali.
# Usage:  cd vm-tests/kali && vagrant up && vagrant destroy -f
Vagrant.configure("2") do |config|
  config.vm.box = "kalilinux/rolling"
  config.vm.hostname = "torguard-kali"
  config.vm.synced_folder "../../..", "/vagrant", type: "rsync"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 2048
    vb.cpus = 2
  end
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    bash /vagrant/tor-guard/vm-tests/provision.sh /vagrant /vagrant/tor-guard/vm-tests/kali/results
  SHELL
end
