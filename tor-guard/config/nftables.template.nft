#!/usr/sbin/nft -f
# REFERENCE ONLY. The live ruleset is generated by tor_guard.firewall.generator
# and applied atomically via `nft -f`. This file documents the intended shape.
#
# Placeholders: {TOR_UID} {TRANS_PORT} {DNS_PORT}
# Atomic replace idiom (add -> delete -> define) keeps other tables untouched.

add table ip tor_guard_nat
delete table ip tor_guard_nat
table ip tor_guard_nat {
	chain output {
		type nat hook output priority -100; policy accept;
		meta skuid {TOR_UID} accept
		oifname "lo" accept
		ip daddr 127.0.0.0/8 accept
		udp dport 53 redirect to :{DNS_PORT}
		tcp dport 53 redirect to :{DNS_PORT}
		meta l4proto tcp redirect to :{TRANS_PORT}
	}
	chain prerouting {
		type nat hook prerouting priority -100; policy accept;
		iifname "lo" accept
		ip daddr 127.0.0.0/8 accept
		udp dport 53 redirect to :{DNS_PORT}
		tcp dport 53 redirect to :{DNS_PORT}
		meta l4proto tcp redirect to :{TRANS_PORT}
	}
}

add table inet tor_guard_filter
delete table inet tor_guard_filter
table inet tor_guard_filter {
	chain input {
		type filter hook input priority 0; policy drop;
		meta nfproto ipv6 drop
		iifname "lo" accept
		ct state established,related accept
		ct state invalid drop
		udp sport 67 udp dport 68 accept
	}
	chain forward {
		type filter hook forward priority 0; policy drop;
		meta nfproto ipv6 drop
		ct state established,related accept
		ct state invalid drop
	}
	chain output {
		type filter hook output priority 0; policy drop;
		meta nfproto ipv6 drop
		oifname "lo" accept
		meta skuid {TOR_UID} accept
		ct state established,related accept
		ct state invalid drop
		udp sport 68 udp dport 67 accept
		tcp dport 53 drop
		udp dport 53 drop
		meta l4proto udp drop
	}
}

add table ip6 tor_guard6
delete table ip6 tor_guard6
table ip6 tor_guard6 {
	chain input   { type filter hook input   priority 0; policy drop; iifname "lo" accept }
	chain forward { type filter hook forward priority 0; policy drop; }
	chain output  { type filter hook output  priority 0; policy drop; oifname "lo" accept }
}
